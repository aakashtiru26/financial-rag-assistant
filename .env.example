FIN_RAG_APP_NAME="Enterprise Financial RAG Assistant"
FIN_RAG_ENVIRONMENT=local
FIN_RAG_API_KEY=your-api-key-here

FIN_RAG_OLLAMA_BASE_URL=http://localhost:11434
FIN_RAG_OLLAMA_LLM_MODEL=llama3.2:1b
FIN_RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

FIN_RAG_DATA_DIR=./data
FIN_RAG_UPLOAD_DIR=./data/uploads
FIN_RAG_INDEX_DIR=./data/index
FIN_RAG_METADATA_DIR=./data/metadata

FIN_RAG_CHUNK_SIZE=1200
FIN_RAG_CHUNK_OVERLAP=180
FIN_RAG_RETRIEVAL_K=5
FIN_RAG_MAX_UPLOAD_MB=50
FIN_RAG_LOG_LEVEL=INFO

GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
